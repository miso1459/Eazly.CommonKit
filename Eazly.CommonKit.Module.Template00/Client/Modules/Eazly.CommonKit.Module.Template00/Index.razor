@using System.Data 
@using System.Text.Json
@using System.Linq.Dynamic.Core

@using Eazly.CommonKit.Module.Template00.Services
@using Eazly.CommonKit.Module.Template00.Models
@using Eazly.CommonKit.Module.Template00.Shared.UI
@using System.Threading.Tasks
@using System.Dynamic

@namespace Eazly.CommonKit.Module.Template00
@inherits ModuleBase
@inject ITemplate00Service ClientTemplate00Service
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer
@inject Radzen.NotificationService radzenNotificationService
@inject IJSRuntime JS

<style>
    /* 1. 그리드 내부 테이블이 화면보다 커지더라도 압축되지 않도록 설정 */
    .rz-datagrid-table {
        width: max-content !important; /* 컬럼 너비 합계만큼 늘어남 */
        table-layout: fixed !important; /* 설정된 Width 값을 강제로 유지 */
    }

    /* 2. 헤더와 데이터 영역 모두 동일하게 적용 */
    .rz-grid-table {
        width: max-content !important;
        table-layout: fixed !important;
    }

    /* 3. 가로 스크롤바가 항상 나타나도록 설정 */
    .rz-datagrid-table-wrapper {
        overflow-x: auto !important;
    }

    .no-border {
        border: none;
    }
    .required-border {
        border: 2px solid orange;
    }
    .inValid-border {
        border: 5px solid red;
    }

</style>

@if (_isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <RadzenTheme Theme="material" />
    <RadzenComponents />

    @* 조회조건 *@
    <RadzenCard Variant="Variant.Outlined" class="rz-my-4">
        <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Start" Gap="0.5rem" >
            @if (_sharedTemplate00UI.IsHistoryTable())
            {
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Center" Gap="1rem" >
                    <RadzenLabel Text="조회기간" />
                    <RadzenDatePicker @bind-Value=@_sharedTemplate00UI._Condition.DateFrom DateFormat="yyyy-MM-dd" />
                    <RadzenLabel Text="~" />
                    <RadzenDatePicker @bind-Value=@_sharedTemplate00UI._Condition.DateTo DateFormat="yyyy-MM-dd" />
                </RadzenStack>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenLabel Text="검색조건" />
                <RadzenTextBox @bind-Value=@_sharedTemplate00UI._Condition.SearchValue Placeholder="" Style="width: 505px" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
    
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Normal" Gap="1rem">
        <RadzenDataGrid @ref="_sharedTemplate00UI._grid" Data="@_sharedTemplate00UI._tableRows" TItem="ExpandoObject" GridLines="DataGridGridLines.Both"
        AllowColumnResize="true"
                        AllowSorting="true" AllowMultiColumnSorting="true" ShowMultiColumnSortingIndex="true"
                        AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" LogicalFilterOperator="LogicalFilterOperator.Or"
                        SelectionMode="DataGridSelectionMode.Multiple" @bind-Value=@_sharedTemplate00UI.SelectedRows
                        EditMode="DataGridEditMode.Multiple"
                        LoadData="@_sharedTemplate00UI.OnLoadData"
                        Style="max-height: 1070px; width: 100%; overflow-y: auto;"
                        class="rz-datagrid-scrollable-table">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Normal" Gap="1rem">
                    <RadzenLabel Text=" " />
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Primary" Icon="Search" Click="@OnGetContents" Text=@Localizer["Query"] />
                    @if (!_sharedTemplate00UI._ContentsConifg.IsDisSave)
                    {
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Primary" Icon="Save" Click="@OnSave" Text=@Localizer["Save"] Disabled="@_sharedTemplate00UI._ContentsConifg.IsDisSave" />
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Icon="Add" Text=@Localizer["NewRow"] Click="@_sharedTemplate00UI.InsertRow" Disabled="@_sharedTemplate00UI._ContentsConifg.IsDisCreate" />
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Icon="Edit" Text=@Localizer["EditRow"] Click="@_sharedTemplate00UI.EditRow" Disabled="@_sharedTemplate00UI._ContentsConifg.IsDisUpdate" />
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Icon="check" Text=@Localizer["ApplyRow"] Click="@_sharedTemplate00UI.UpdateRow" Disabled="@_sharedTemplate00UI._ContentsConifg.IsDisUpdate" />
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Warning" Icon="Refresh" Text=@Localizer["CancelRow"] Click="@(args => _sharedTemplate00UI.CancelRow())" Disabled="@_sharedTemplate00UI._ContentsConifg.IsDisSave" />
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Danger" Icon="Delete" Text=@Localizer["DeleteRow"] Click="@(args => _sharedTemplate00UI.DeleteRow())" Disabled="@_sharedTemplate00UI._ContentsConifg.IsDisDelete" />
                    }
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Info" Icon="grid_on" Text="@Localizer["ExportExcel"]" Click="@(args => ExportToExcel(_sharedTemplate00UI))" Disabled="@_sharedTemplate00UI._ContentsConifg.IsDisExport" />
                </RadzenStack>
            </HeaderTemplate>
            <Columns>
                @if (!_sharedTemplate00UI._ContentsConifg.IsDisSave)
                {
                    <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false">
                        <HeaderTemplate>
                            <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select all items" } })"
                            Value="@(_sharedTemplate00UI.SelectedRows == null || _sharedTemplate00UI.SelectedRows?.Any() != true ? false : !_sharedTemplate00UI.SelectedRows.All(i => _sharedTemplate00UI.SelectedRows.Contains(i)) ? null : _sharedTemplate00UI.SelectedRows.Any(i => _sharedTemplate00UI.SelectedRows.Contains(i)))"
                            Change="@(args => _sharedTemplate00UI.SelectedRows = args == true ? _sharedTemplate00UI._tableRows : null)" />
                        </HeaderTemplate>
                        <Template Context="row">
                            <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool" 
                            Value="@(_sharedTemplate00UI.SelectedRows != null && _sharedTemplate00UI.SelectedRows.Contains(row))" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select item" } })"
                            Change=@(args => { _sharedTemplate00UI._grid.SelectRow(row); }) />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ExpandoObject" Title="State" Width="90px" MinWidth="90px" MaxWidth="90px" TextAlign="TextAlign.Center" Property="_rowState" Filterable="false">
                        <Template Context="row">
                            @{
                                var dict = (IDictionary<string, object>)row;
                                string state = dict.ContainsKey("_rowState") && dict["_rowState"] != DBNull.Value ? dict["_rowState"].ToString() : string.Empty;

                                string icon = "info";
                                string color = "var(--rz-info)";

                                if (state == "Insert")
                                {
                                    icon = "add_circle"; color = "var(--rz-success)";
                                }
                                else if (state == "Delete")
                                {
                                    icon = "remove_circle"; color = "var(--rz-danger)";
                                }
                                else if (state == "Update")
                                {
                                    icon = "edit"; color = "var(--rz-warning)";
                                }
                            }
                            <RadzenIcon Icon="@icon" Style=@($"color: {color};") />
                        </Template>
                    </RadzenDataGridColumn>
                }

                @foreach (DataColumn col in _sharedTemplate00UI._dataTable.Columns)
                {
                    @if (_sharedTemplate00UI.ignoreList.Contains(col.ColumnName)) continue;

                    var colName = col.ColumnName;

                    @if (_sharedTemplate00UI.byList.Contains(colName))
                    {
                        <RadzenDataGridColumn TItem="ExpandoObject" Title="@colName" Width="100px" MinWidth="100px" Property="@colName" Type="col.DataType">
                            <Template Context="row">
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                }
                                @colValue
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    else if (_sharedTemplate00UI.onList.Contains(colName))
                    {
                        <RadzenDataGridColumn TItem="ExpandoObject" Title="@colName" Width="200px" MinWidth="200px" MaxWidth="200px" Property="@colName" Type="col.DataType" Filterable="true">
                            <FilterTemplate Context="column">
                                <RadzenDatePicker TValue="DateTime?" Style="width:100%;" AllowClear="true" DateFormat="d"
                                                  Change="@(args => OnDateFilterChange(column, args))" />
                            </FilterTemplate>
                            <Template Context="row">
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                }
                                @colValue
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    else if (col.DataType == typeof(DateTime))
                    {
                        <RadzenDataGridColumn TItem="ExpandoObject" Title="@col.Caption" Width="@_sharedTemplate00UI.GetColumnWidth(col)" Property="@colName" Type="col.DataType" Visible="@_sharedTemplate00UI.IsColumnVisible(col)" Filterable="true">
                            <FilterTemplate Context="column">
                                    <RadzenDatePicker TValue="DateTime?" Style="width:100%;" AllowClear="true" DateFormat="d" 
                                        Change="@(args => OnDateFilterChange(column, args))" />
                            </FilterTemplate>
                            <Template Context="row">
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                }

                                @_sharedTemplate00UI.GetColumnFormatValue(col, colValue)
                            </Template>

                            <EditTemplate Context="row">
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string TId = dict.ContainsKey("TId") && dict["TId"] != DBNull.Value ? dict["TId"].ToString() : string.Empty;
                                    string state = dict.ContainsKey("_rowState") && dict["_rowState"] != DBNull.Value ? dict["_rowState"].ToString() : string.Empty;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                    string strComponentName = $"{colName}_{TId}";
                                    string columnFormat = _sharedTemplate00UI.GetColumnFormat(col);

                                    @if (col.ReadOnly || (state != "Insert" && _sharedTemplate00UI.IsColumnPrimary(col)))
                                        @_sharedTemplate00UI.GetColumnFormatValue(col, colValue)
                                    else
                                    {
                                        <div class="@_sharedTemplate00UI.GetBorderClass(col, row)">
                                            <RadzenDatePicker Name="@strComponentName" TValue="DateTime?" DateFormat="@columnFormat" Value="@(string.IsNullOrEmpty(colValue) ? (DateTime?)null : DateTime.Parse(colValue))" Change="@((DateTime? v) => _sharedTemplate00UI.OnUpdateDataValue(col, row, v?.ToString("yyyy-MM-dd")))" Style="width:100%;" />
                                        </div>
                                    }
                                }
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    }
                    else
                    {
                        <RadzenDataGridColumn TItem="ExpandoObject" Title="@col.Caption" Width="@_sharedTemplate00UI.GetColumnWidth(col)" Property="@colName" Type="col.DataType" Visible="@_sharedTemplate00UI.IsColumnVisible(col)" Filterable="true">
                            <Template Context="row">
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                }

                                @_sharedTemplate00UI.GetColumnFormatValue(col, colValue)
                            </Template>

                            <EditTemplate Context="row">
                                @{
                                var dict = (IDictionary<string, object>)row;
                                string TId = dict.ContainsKey("TId") && dict["TId"] != DBNull.Value ? dict["TId"].ToString() : string.Empty;
                                string state = dict.ContainsKey("_rowState") && dict["_rowState"] != DBNull.Value ? dict["_rowState"].ToString() : string.Empty;
                                string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                string strComponentName = $"{colName}_{TId}";
                                string columnFormat = _sharedTemplate00UI.GetColumnFormat(col);

                                @if (col.ReadOnly || (state != "Insert" && _sharedTemplate00UI.IsColumnPrimary(col)))
                                    @_sharedTemplate00UI.GetColumnFormatValue(col, colValue)
                                else
                                {
                                    <div class="@_sharedTemplate00UI.GetBorderClass(col, row)">
                                        @if (col.DataType == typeof(DateTime))
                                        {
                                            <RadzenDatePicker Name="@strComponentName" TValue="DateTime?" DateFormat="@columnFormat" Value="@(string.IsNullOrEmpty(colValue) ? (DateTime?)null : DateTime.Parse(colValue))" Change="@((DateTime? v) => _sharedTemplate00UI.OnUpdateDataValue(col, row, v?.ToString("yyyy-MM-dd")))" Style="width:100%;" />
                                        }
                                        else if (col.DataType == typeof(int) || col.DataType == typeof(decimal) || col.DataType == typeof(double))
                                        {
                                            <RadzenNumeric Name="@strComponentName" TValue="decimal?" Format="@columnFormat" Value="@(string.IsNullOrEmpty(colValue) ? 0 : Convert.ToDecimal(colValue))" Change="@((decimal? v) => _sharedTemplate00UI.OnUpdateDataValue(col, row, v?.ToString()))" Style="width:100%;" />
                                        }
                                        else if (col.DataType == typeof(Boolean))
                                        {
                                            <RadzenCheckBox Name="@strComponentName" TValue="Boolean?" Format="@columnFormat" Value="@(string.IsNullOrEmpty(colValue) ? (bool?)null : (colValue == "True"))" Change="@((Boolean? v) => _sharedTemplate00UI.OnUpdateDataValue(col, row, v?.ToString()))" Style="width:100%;" />
                                        }
                                        else
                                        {
                                            <RadzenTextBox Name="@strComponentName" Value="@colValue" Change="@(v => _sharedTemplate00UI.OnUpdateDataValue(col, row, v))" Style="width:100%;" />
                                        }
                                        </div>
                                    }
                                }
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    }
                }

            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
}

@code {
    public override string RenderMode => RenderModes.Interactive;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/Radzen.Blazor/css/material.css"),
        new Stylesheet("_content/Radzen.Blazor/css/material-dark.css"),
        new Resource { ResourceType = ResourceType.Script, Level = ResourceLevel.Site, Url = "_content/Radzen.Blazor/Radzen.Blazor.js" },

        new Stylesheet("_content/Eazly.CommonKit.Module.Template00/Module.css"),
        new Resource { ResourceType = ResourceType.Script, Level = ResourceLevel.Site, Url = "_content/Eazly.CommonKit.Module.Template00/Module.js" },
        new Resource { ResourceType = ResourceType.Script, Level = ResourceLevel.Site, Url = "https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js" },
    };

    private string ElementId = $"mymodule-{Guid.NewGuid()}";

    private bool _isLoading = true;

    private Template00UI _sharedTemplate00UI;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sharedTemplate00UI = new Template00UI(PageState.User?.Username, radzenNotificationService);
            _sharedTemplate00UI._Condition = await ClientTemplate00Service.GetConditionAsync(ModuleState.ModuleId);
            _sharedTemplate00UI._ContentsConifg = await ClientTemplate00Service.GetConfigContentsAsync(ModuleState.ModuleId, "");

            await OnGetContents();

            _isLoading = _sharedTemplate00UI._dataTable == null;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Template00 {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

        }
    }

    private async Task OnGetContents()
    {
        try
        {
            string jsonCondition = JsonSerializer.Serialize(_sharedTemplate00UI._Condition);
            _sharedTemplate00UI._dataTable = await ClientTemplate00Service.GetContentsIDAsync(ModuleState.ModuleId, "", jsonCondition);

            _sharedTemplate00UI._tableRows = _sharedTemplate00UI._dataTable.AsEnumerable().Select(row =>
            {
                var obj = new ExpandoObject() as IDictionary<string, object>;
                foreach (DataColumn dataColumn in _sharedTemplate00UI._dataTable.Columns)
                {
                    obj.Add(dataColumn.ColumnName, row[dataColumn]);
                }
                return (ExpandoObject)obj;
            }).ToList();

            _sharedTemplate00UI.SetSelectedRows(_sharedTemplate00UI._tableRows.Take(1).ToList());

            NotificationMessage message = new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "조회 완료",
                Detail = $"조회가 완료 되었습니다..",
                Duration = 3000
            };
            radzenNotificationService.Notify(message);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error OnGetContents {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.QueryError"], MessageType.Error);
        }
    }

    private async Task OnSave()
    {
        try
        {
            NotificationMessage message;

            await _sharedTemplate00UI.UpdateRow();

            string jsonDataTable = _sharedTemplate00UI.GetJsonDataTable();

            if (string.IsNullOrEmpty(jsonDataTable))
            {
                message = new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "저장할 데이터 없음",
                    Detail = $"저장할 데이터가 없습니다..",
                    Duration = 3000
                };
                radzenNotificationService.Notify(message);
                return;
            }

            await ClientTemplate00Service.ExecuteQueryIDAsync(ModuleState.ModuleId, "Save", jsonDataTable);

            message = new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "저장 완료",
                Detail = $"저장이 완료 되었습니다..",
                Duration = 3000
            };
            radzenNotificationService.Notify(message);

            await OnGetContents();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error OnSave {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
        }
    }

    private async Task ExportToExcel(Template00UI sharedTemplate00UI)
    {
        try
        {
            // await JS.InvokeVoidAsync("Eazly.Template00.showMessage", "Hello from Oqtane Module!");

            await JS.InvokeVoidAsync("Eazly.Template00.exportToExcel", sharedTemplate00UI.TableRows, ModuleState?.Title);

        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Export to Excel {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.ExportToExcelError"], MessageType.Error);
        }
    }

    private void OnDateFilterChange(RadzenDataGridColumn<ExpandoObject> column, object value)
    {
        // 1. 컬럼의 필터 값을 업데이트
        column.SetFilterValue(value);
        
        // 2. 필터 연산자 설정 (필요 시)
        column.SetFilterOperator(FilterOperator.StartsWith);

        // 3. 그리드 리로드 (실제 데이터 필터링 수행)
        _sharedTemplate00UI._grid.Reload();
    }
}