@using System.Data 
@using System.Text.Json
@using System.Linq.Dynamic.Core

@using Eazly.CommonKit.Module.Template00.Services
@using Eazly.CommonKit.Module.Template00.Models
@using System.Threading.Tasks
@using System.Dynamic

@namespace Eazly.CommonKit.Module.Template00
@inherits ModuleBase
@inject ITemplate00Service ClientTemplate00Service
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<style>
    /* 1. 그리드 내부 테이블이 화면보다 커지더라도 압축되지 않도록 설정 */
    .rz-datagrid-table {
        width: max-content !important; /* 컬럼 너비 합계만큼 늘어남 */
        table-layout: fixed !important; /* 설정된 Width 값을 강제로 유지 */
    }

    /* 2. 헤더와 데이터 영역 모두 동일하게 적용 */
    .rz-grid-table {
        width: max-content !important;
        table-layout: fixed !important;
    }

    /* 3. 가로 스크롤바가 항상 나타나도록 설정 */
    .rz-datagrid-table-wrapper {
        overflow-x: auto !important;
    }
</style>

@if (_isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <RadzenTheme Theme="material" />
    <RadzenComponents />

    @* 조회조건 *@
    <RadzenCard Variant="Variant.Outlined" class="rz-my-4">
        <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Start" Gap="0.5rem" >
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Center" Gap="1rem" >
                <RadzenLabel Text="조회기간" />
                <RadzenDatePicker @bind-Value=@_Condition.DateFrom DateFormat="yyyy-MM-dd" />
                    <RadzenLabel Text="~" />
                <RadzenDatePicker @bind-Value=@_Condition.DateTo DateFormat="yyyy-MM-dd" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenLabel Text="검색조건" />
                <RadzenTextBox @bind-Value=@_Condition.SearchValue Placeholder="" Style="width: 505px" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
    
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Normal" Gap="1rem">
        <RadzenDataGrid @ref="grid1" Data="@_tableRows1" TItem="ExpandoObject" AllowColumnResize="true"
                        AllowSorting="true" AllowMultiColumnSorting="true" ShowMultiColumnSortingIndex="true"
                        AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" LogicalFilterOperator="LogicalFilterOperator.Or"
                        SelectionMode="DataGridSelectionMode.Single" @bind-Value=@_selectedRows1
                        EditMode="DataGridEditMode.Single"
                        LoadData="@OnLoadData"
                        Style="max-height: 1070px; width: 100%; overflow-y: auto;"
                        class="rz-datagrid-scrollable-table">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Left" AlignItems="AlignItems.Normal" Gap="1rem">
                    <RadzenLabel Text=" " />
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Primary" Click="@OnGetContents" Text=@Localizer["Query"] />
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Primary" Click="@OnSave" Text=@Localizer["Save"] Disabled="@_ContentsConifg.IsDisSave" />
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text=@Localizer["NewRow"] Click="@InsertRow" Disabled="@_ContentsConifg.IsDisCreate" />
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Warning" Icon="refresh" Text=@Localizer["CancelRow"] Click="@(args => CancelRow())" Disabled="@_ContentsConifg.IsDisSave" />
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Danger" Icon="delete" Text=@Localizer["DeleteRow"] Click="@(args => DeleteRow())" Disabled="@_ContentsConifg.IsDisDelete" />
                    
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Info" Text="Export XLS" Icon="grid_on" Click="@(args => Export("excel", "grid1"))" Disabled="@_ContentsConifg.IsDisExport" />
                </RadzenStack>
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="ExpandoObject" Title="State" Width="90px" MinWidth="90px" MaxWidth="90px" TextAlign="TextAlign.Center" Property="_rowState" Filterable="false">
                    <Template Context="row">
                        @{
                            var dict = (IDictionary<string, object>)row;
                            string state = dict.ContainsKey("_rowState") && dict["_rowState"] != DBNull.Value ? dict["_rowState"].ToString() : string.Empty;

                            string icon = "info";
                            string color = "var(--rz-info)";

                            if (state == "Insert") {
                                icon = "add_circle"; color = "var(--rz-success)"; 
                            } else if (state == "Delete") {
                                icon = "remove_circle"; color = "var(--rz-danger)"; 
                            } else if (state == "Update") { 
                                icon = "edit"; color = "var(--rz-warning)"; 
                            }
                        }
                        <RadzenIcon Icon="@icon" Style=@($"color: {color};") />
                    </Template>
                </RadzenDataGridColumn>

                @foreach (DataColumn col in _dataTable.Columns)
                {
                    @if (ignoreList.Contains(col.ColumnName)) continue;

                    var colName = col.ColumnName;

                    @if (byList.Contains(colName))
                    {
                        <RadzenDataGridColumn TItem="ExpandoObject" Title="@colName" Width="100px" MinWidth="100px" Property="@colName" Type="col.DataType">
                            <Template Context="row">
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                }
                                @colValue
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    else if (onList.Contains(colName))
                    {
                        <RadzenDataGridColumn TItem="ExpandoObject" Title="@colName" Width="200px" MinWidth="200px" MaxWidth="200px" Property="@colName" Type="col.DataType" Filterable="false">
                            <Template Context="row">
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                }
                                @colValue
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    else
                    {
                        <RadzenDataGridColumn TItem="ExpandoObject" Title="@col.Caption" Width="@GetColumnWidth(col)" Property="@colName" Type="col.DataType" Visible="@IsColumnVisible(col)" Filterable="col.DataType == typeof(string)">
                            <Template Context="row"> 
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
                                }

                                @GetColumnFormatValue(col, colValue)
                            </Template>

                            <EditTemplate Context="row">
                                @{
                                    var dict = (IDictionary<string, object>)row;
                                    string TId = dict.ContainsKey("TId") && dict["TId"] != DBNull.Value ? dict["TId"].ToString() : string.Empty;
                                    string state = dict.ContainsKey("_rowState") && dict["_rowState"] != DBNull.Value ? dict["_rowState"].ToString() : string.Empty;
                                    string colValue = dict.ContainsKey(colName) && dict[colName] != DBNull.Value ? dict[colName].ToString() : string.Empty;
									string strComponentName = $"{colName}_{TId}";

                                    @if (col.ReadOnly || (state != "Insert" && IsColumnPrimary(col)))
                                        @GetColumnFormatValue(col, colValue)
                                    else
                                    {
                                        <RadzenTextBox Name="@strComponentName" Value="@colValue" Change="@(v => OnUpdateDataValue(colName, row, v))" Style="width:100%;" />
                                        <RadzenCustomValidator Component="@strComponentName" Validator="@(() => CustomValidate(col, row))" Text="필수입력 입니다." Popup="true" />
                                    }
                                }
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    }
                }

                <RadzenDataGridColumn TItem="ExpandoObject" Context="row" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="50px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                    <Template>
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(row))" @onclick:stopPropagation="true" />
                    </Template>
                    <EditTemplate>
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => OnUpdateRow(row))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
}

@code {
    public override string RenderMode => RenderModes.Interactive;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/Radzen.Blazor/css/material.css"),
        new Stylesheet("_content/Radzen.Blazor/css/material-dark.css"),
        new Resource { ResourceType = ResourceType.Script, Level = ResourceLevel.Site, Url = "_content/Radzen.Blazor/Radzen.Blazor.js" },

        new Stylesheet("_content/Eazly.CommonKit.Module.Template00/Module.css"),
        new Script("_content/Eazly.CommonKit.Module.Template00/Module.js"),
    };

    private bool _isLoading = true;

    private Models.Contition _Condition;

    private Models.ContentsConifg _ContentsConifg;
    private DataTable _dataTable;
    private IList<ExpandoObject> _tableRows1 = new List<ExpandoObject>();
    private IList<ExpandoObject> _selectedRows1;
    private IList<ExpandoObject> _allRows1 = new List<ExpandoObject>();

    private RadzenDataGrid<ExpandoObject> grid1;

    private string[] ignoreList = { "TId", "_rowState", "TenantId", "SiteId" };
    private string[] byList = { "CreatedBy", "ModifiedBy" };
    private string[] onList = { "CreatedOn", "ModifiedOn" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _Condition = await ClientTemplate00Service.GetConditionAsync(ModuleState.ModuleId);

            _ContentsConifg = await ClientTemplate00Service.GetConfigContentsAsync(ModuleState.ModuleId, "");

            await OnGetContents();

            _isLoading = false;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Template00 {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // await SetEditMode(grid1);
        }
    }

    private bool IsColumnPrimary(DataColumn dataColumn)
    {
        bool isPrimary = false;

        if (dataColumn != null)
        {
            if (dataColumn.ExtendedProperties.ContainsKey("IsPrimary"))
                isPrimary = dataColumn.ExtendedProperties["IsPrimary"]?.ToString().ToUpper() == "Y";
        }

        return isPrimary;
    }

    private bool IsColumnVisible(DataColumn dataColumn)
    {
        bool isVisible = false;

        if (dataColumn != null)
        {
            if (dataColumn.ExtendedProperties.ContainsKey("IsVisible"))
                isVisible = dataColumn.ExtendedProperties["IsVisible"]?.ToString().ToUpper() == "Y";
        }

        return isVisible;
    }

    private string GetColumnWidth(DataColumn dataColumn)
    {
        int iWidth = 100;

        if (dataColumn != null)
        {
            if (dataColumn.ExtendedProperties.ContainsKey("Width"))
                iWidth = Convert.ToInt32(dataColumn.ExtendedProperties["Width"]);
        }

        return iWidth.ToString()+"px";
    }

    private string GetColumnFormatValue(DataColumn dataColumn, string strValue)
    {
        string strFormatValue = strValue;

        if (dataColumn != null)
        {
            if (dataColumn.ExtendedProperties.ContainsKey("DataFormat"))
            {
                string strDataFormat = dataColumn.ExtendedProperties["DataFormat"].ToString();
                if (!string.IsNullOrEmpty(strDataFormat))
                    strFormatValue = string.Format(strDataFormat, strValue);
            }
        }

        return strFormatValue;
    }

    private async Task SetEditMode(RadzenDataGrid<ExpandoObject> grid)
    {
        if (grid != null && grid.IsValid)
        {
            foreach (ExpandoObject row in _tableRows1)
            {
                await EditRow(row);
            }
        }
    }

    private async Task OnGetContents()
    {
        try
        {
            string jsonCondition = JsonSerializer.Serialize(_Condition);
            _dataTable = await ClientTemplate00Service.GetContentsIDAsync(ModuleState.ModuleId, "", jsonCondition);

            _tableRows1 = _dataTable.AsEnumerable().Select(row =>
            {
                var obj = new ExpandoObject() as IDictionary<string, object>;
                foreach (DataColumn col in _dataTable.Columns)
                {
                    obj.Add(col.ColumnName, row[col]);
                }
                return (ExpandoObject)obj;
            }).ToList();

            _selectedRows1 = _tableRows1.Take(1).ToList();
            _allRows1 = _tableRows1.ToList();

            // await SetEditMode(grid1);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error OnGetContents {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.QueryError"], MessageType.Error);
        }
    }

    private async Task OnSave()
    {
        try
        {
            if (grid1 == null || !grid1.IsValid) return;

            string jsonDataTable = string.Empty;
            if (_tableRows1 != null && _tableRows1.Count() > 0)
            {
                var jsonList = _tableRows1.Where(row => !string.IsNullOrEmpty(((IDictionary<string, object>)row)["_rowState"]?.ToString())).ToList();
                jsonDataTable = JsonSerializer.Serialize(jsonList);
            }

            await ClientTemplate00Service.ExecuteQueryIDAsync(ModuleState.ModuleId, "", jsonDataTable);

            await OnGetContents();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error OnSave {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
        }
    }

    private async Task Export(string type, string gridName)
    {
        try
        {

        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Export to Excel {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.ExportToExcelError"], MessageType.Error);
        }
    }

    private async Task OnUpdateDataValue(string colName, ExpandoObject row, object newValue)
    {
        if (row == null) return;

        var dict = (IDictionary<string, object>)row;
        dict[colName] = newValue;

        // await OnUpdateRow(row);
        // await EditRow(row);
    }

    private async Task OnUpdateRow(ExpandoObject row)
    {
        if (grid1 == null || !grid1.IsValid) return;

        var dict = (IDictionary<string, object>)row;

        if (dict["_rowState"].ToString() != "Insert")
            dict["_rowState"] = "Update";

        await grid1.UpdateRow(row);
    }

    private bool CustomValidate(DataColumn col, ExpandoObject row)
    {
		if (col == null || row == null) return true;
		if (col.AllowDBNull) return true;

        var dict = (IDictionary<string, object>)row;
        object value = dict.ContainsKey(col.ColumnName) ? dict[col.ColumnName] : null;

        if (col.DataType == typeof(string))
			return !string.IsNullOrEmpty(value?.ToString());
        else if (col.DataType == typeof(int) || col.DataType == typeof(long) || col.DataType == typeof(decimal) || col.DataType == typeof(double) || col.DataType == typeof(float))
            return value != null && !value.Equals(0);
        else if (col.DataType == typeof(DateTime))
            return value != null && !value.Equals(DateTime.MinValue);

		return true;
    }

    private async Task InsertRow()
    {
        if (PageState.User == null) return;

        if (grid1 == null || !grid1.IsValid) return;

        DataRow newRow = _dataTable.NewRow();
        newRow["_rowState"] = "Insert";

        foreach (DataColumn col in _dataTable.Columns)
        {
            if (ignoreList.Contains(col.ColumnName)) continue;

            if (byList.Contains(col.ColumnName))
                newRow[col.ColumnName] = PageState.User.Username;
            else if (onList.Contains(col.ColumnName))
                newRow[col.ColumnName] = DateTime.Now;
            else if (!col.AllowDBNull && newRow[col.ColumnName] == null)
            {
                if (col.DataType == typeof(string))
                    newRow[col.ColumnName] = string.Empty;
                else if (col.DataType == typeof(int) || col.DataType == typeof(long) || col.DataType == typeof(decimal) || col.DataType == typeof(double) || col.DataType == typeof(float))
                    newRow[col.ColumnName] = 0;
                else if (col.DataType == typeof(DateTime))
                    newRow[col.ColumnName] = null;
                else if (col.DataType == typeof(bool))
                    newRow[col.ColumnName] = false;
                else if (col.DataType.IsValueType)
                    newRow[col.ColumnName] = Activator.CreateInstance(col.DataType);
            }
        }

        // _dataTable.Rows.InsertAt(newRow, 0);

        var expando = new ExpandoObject() as IDictionary<string, object>;
        foreach (DataColumn col in newRow.Table.Columns)
        {
            expando[col.ColumnName] = newRow[col];
        }

        _tableRows1.Insert(0, (ExpandoObject)expando);
        _selectedRows1 = _tableRows1.Take(1).ToList();
        _allRows1.Insert(0, (ExpandoObject)expando);

        await grid1.Reload();

        await SetEditMode(grid1);

        StateHasChanged();
    }

    private async Task EditRow()
    {
        if (grid1 == null || !grid1.IsValid) return;

        foreach (ExpandoObject row in _selectedRows1)
        {
            await EditRow(row);
        }
    }

    private async Task EditRow(ExpandoObject row)
    {
        if (grid1 == null || !grid1.IsValid || row == null) return;

        if (!grid1.IsRowInEditMode(row))
		    await grid1.EditRow(row);
    }

    private async Task CancelRow()
    {
        if (grid1 == null || !grid1.IsValid) return;

        foreach (ExpandoObject row in _selectedRows1)
        {
            await CancelRow(row);
        }
    }

    private async Task CancelRow(ExpandoObject row)
    {
        if (grid1 == null || !grid1.IsValid || row == null) return;

        var dict = (IDictionary<string, object>)row;
        string state = dict.ContainsKey("_rowState") && dict["_rowState"] != DBNull.Value ? dict["_rowState"].ToString() : string.Empty;

        grid1.CancelEditRow(row);

        if (state == "Insert")
        {
            _tableRows1.Remove(row);
            _allRows1.Remove(row);

			_tableRows1 = _tableRows1.ToList();
            _selectedRows1 = _tableRows1.Take(1).ToList();

            StateHasChanged();
        }
        else
        {
            DataRow[] dataRows = _dataTable.Select(string.Format("Tid = '{0}'", dict["TId"]));
            if (dataRows.Length > 0)
            {
                DataRow dataRow = dataRows[0];

                dict["_rowState"] = string.Empty;

                if (dataRow.HasVersion(DataRowVersion.Original))
                {
                    foreach (DataColumn col in _dataTable.Columns)
                    {
                        if (ignoreList.Contains(col.ColumnName)) continue;
                        if (byList.Contains(col.ColumnName)) continue;
                        if (onList.Contains(col.ColumnName)) continue;

                        dict[col.ColumnName] = dataRow[col.ColumnName, DataRowVersion.Original];
                    }
                }

                // await EditRow(row);
            }
        }
    }

    private async Task DeleteRow()
    {
        if (grid1 == null || !grid1.IsValid) return;

        foreach (ExpandoObject row in _selectedRows1)
        {
            await DeleteRow(row);
        }
    }

    private async Task DeleteRow(ExpandoObject row)
    {
        if (grid1 == null || !grid1.IsValid || row == null) return;

        var dict = (IDictionary<string, object>)row;
        string state = dict.ContainsKey("_rowState") && dict["_rowState"] != DBNull.Value ? dict["_rowState"].ToString() : string.Empty;

        if (state == "Insert")
            await CancelRow(row);
        else
            dict["_rowState"] = "Delete";
    }

    private void OnLoadData(LoadDataArgs args)
    {
        if (_allRows1 != null && _allRows1.Count > 0)
        {
            _tableRows1 = _allRows1.ToList();
        }

        // 1. 원본 데이터에서 시작 (필터링 전 원본 보관 변수가 있다면 그것을 사용하세요)
        IEnumerable<dynamic> query = _tableRows1;

        // 2. 필터링 로직 (추가된 부분)
        if (args.Filters != null && args.Filters.Any())
        {
            foreach (var filter in args.Filters)
            {
                var prop = filter.Property;
                var val = filter.FilterValue?.ToString().ToLower();
                if (string.IsNullOrEmpty(val)) continue;

                query = query.Where(x =>
                {
                    var dict = (IDictionary<string, object>)x;
                    if (dict.ContainsKey(prop) && dict[prop] != null)
                    {
                        // 문자열 포함 여부 검사 (단순화된 예시)
                        return dict[prop].ToString().ToLower().Contains(val);
                    }
                    return false;
                });
            }
        }

        // 3. 정렬 로직 (기존 코드 유지)
        if (args.Sorts != null && args.Sorts.Any())
        {
            IOrderedEnumerable<dynamic> ordered = null;
            foreach (var sort in args.Sorts)
            {
                var prop = sort.Property;
                var isAsc = sort.SortOrder == SortOrder.Ascending;
                Func<dynamic, object> keySelector = x => ((IDictionary<string, object>)x).ContainsKey(prop) ? ((IDictionary<string, object>)x)[prop] : null;

                if (ordered == null)
                    ordered = isAsc ? query.OrderBy(keySelector) : query.OrderByDescending(keySelector);
                else
                    ordered = isAsc ? ordered.ThenBy(keySelector) : ordered.ThenByDescending(keySelector);
            }
            if (ordered != null) query = ordered;
        }

        // 4. 최종 결과 반영
        _tableRows1 = query.Select(x => (ExpandoObject)x).ToList();
    }

}